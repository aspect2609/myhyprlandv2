{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 4,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "hyprland/window",
        "custom/weather"
    ],
    "modules-center": ["clock", "custom/date"],
    "modules-right": [
        "pulseaudio",
        "backlight",
        "battery",
        "tray",
        "custom/power"
    ],

    "hyprland/window": {
        "format": "󱂬  {}",
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  Firefox",
            "(.*) - Visual Studio Code": "󰨞  VS Code",
            "(.*) - Discord": "󰙯  Discord",
            "^$": "󰇄  Desktop"
        },
        "max-length": 25
    },

    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "interval": 1800,
        "exec": "curl -s 'wttr.in/?format=1'",
        "on-click": "xdg-open https://wttr.in"
    },

    "custom/launcher": {
        "format": " ",
        "on-click": "rofi -show drun",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "sort-by-number": true
    },

    "clock": {
        "format": "  {:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/date": {
        "exec": "python3 -c \"import datetime; d=datetime.date.today(); s='th' if 11<=d.day<=13 else {1:'st',2:'nd',3:'rd'}.get(d.day%10,'th'); print(d.strftime('%A %-d')+s+d.strftime(' %B'))\"",
        "interval": 3600,
        "format": "  {}",
        "tooltip": false
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "  muted",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/power": {
        "format": " ",
        "on-click": "wlogout",
        "tooltip": false
    }
}