{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "modules-left": [
        "custom/launcher", 
        "hyprland/workspaces",
        "hyprland/window",
        "custom/weather",
        "mpris"
    ],
    "modules-center": ["clock", "custom/date"],
    "modules-right": [
        "pulseaudio",
        "custom/keyboard-light",
        "backlight",
        "battery",
        "tray",
        "idle_inhibitor",
        "custom/notification",
        "custom/power"
    ],

    "hyprland/window": {
        "format": "󱂬  {}",
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  Firefox",
            "(.*) - Visual Studio Code": "󰨞  VS Code",
            "(.*) - Discord": "󰙯  Discord",
            "^$": "󰇄  Desktop"
        },
        "max-length": 20
    },

    "mpris": {
        "format": "{player_icon} {title}",
        "player-icons": { "default": "▶", "spotify": "" },
        "max-length": 15
    },

    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "interval": 1800,
        "exec": "curl -s 'wttr.in/?format=1'"
    },

    "custom/launcher": { "format": " ", "on-click": "rofi -show drun" },

    "hyprland/workspaces": { "format": "{name}", "on-click": "activate" },

    "clock": { "format": "  {:%H:%M}" },

    "custom/date": {
        "exec": "date +'%A %d'$(date +%d | sed 's/01/st/;s/02/nd/;s/03/rd/;s/[0-9][1-3]/th/;s/[04-09]/th/;s/1[1-3]/th/')' %B'",
        "interval": 3600,
        "format": "  {}"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-"
    },

   "custom/keyboard-light": {
    "format": "󰌌 ",
    "tooltip": false,
    "on-click": "brightnessctl -d *kbd_backlight* get | grep -q '^0$' && brightnessctl -d *kbd_backlight* set 100% || brightnessctl -d *kbd_backlight* set 0",
    "on-scroll-up": "brightnessctl -d *kbd_backlight* set 10%+",
    "on-scroll-down": "brightnessctl -d *kbd_backlight* set 10%-",
    "interval": 1 
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": " ", "deactivated": " " }
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<sup></sup>",
            "none": " ",
            "dnd-notification": "<sup></sup>",
            "dnd-none": " "
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "escape": true
    },

    "tray": { "icon-size": 18, "spacing": 10 },

    "custom/power": { "format": " ", "on-click": "wlogout" }
}