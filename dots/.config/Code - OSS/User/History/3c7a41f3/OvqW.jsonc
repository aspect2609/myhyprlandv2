{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "modules-left": [
        "custom/launcher", 
        "hyprland/workspaces",
        "hyprland/window", // New location
        "custom/weather"
    ],
    "modules-center": ["clock", "custom/date"],
    "modules-right": [
        "pulseaudio",
        "backlight",
        "battery",
        "tray",
        "custom/power"
    ],

    "hyprland/window": {
        "format": "󱂬  {}",
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  Firefox",
            "(.*) - Visual Studio Code": "󰨞  VS Code",
            "(.*) - Discord": "󰙯  Discord",
            "^$": "󰇄  Desktop" // Shown when no window is focused
        },
        "max-length": 25
    },

    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "interval": 1800,
        "exec": "curl -s 'wttr.in/?format=1'",
        "on-click": "xdg-open https://wttr.in"
    },

    "custom/launcher": {
        "format": " ",
        "on-click": "rofi -show drun", 
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true
    },

    "clock": {
        "format": "  {:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/date": {
        "exec": "date +'%A %d'$(date +%d | sed 's/01/st/;s/02/nd/;s/03/rd/;s/[0-9][1-3]/th/;s/[04-09]/th/;s/1[1-3]/th/')' %B'",
        "interval": 3600,
        "format": "  {}",
        "tooltip": false
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " ",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "custom/power": {
        "format": " ",
        "on-click": "wlogout", 
        "tooltip": false
    }
}