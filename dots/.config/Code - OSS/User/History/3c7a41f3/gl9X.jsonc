{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "modules-left": [
        "custom/launcher",
        "custom/btop",
        "custom/updates",
        "hyprland/workspaces",
        "hyprland/window",
        "custom/weather",
        "mpris"
    ],
    "modules-center": [
        "clock",
        "custom/date"
    ],
    "modules-right": [
        "pulseaudio",
        "custom/keyboard-light",
        "backlight",
        "battery",
        "tray",
        "idle_inhibitor",
        "custom/notification",
        "custom/power"
    ],

    "custom/launcher": {
        "format": " ",
        "on-click": "rofi -show drun",
        "tooltip": false
    },

    "custom/btop": {
        "format": "󰄪",
        "on-click": "kitty --class btop -e btop",
        "tooltip": false
    },

    "custom/updates": {
        "format": "󰚰 {}",
        "escape": true,
        "return-type": "json",       
        "exec": "count=$(checkupdates | wc -l); echo \"{\\\"text\\\":\\\"$count\\\"}\"",
        "on-click": "kitty -e sudo pacman -Syyu",
        "interval": 3600,
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true
    },

    "hyprland/window": {
        "format": "󱂬  {}",
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  Firefox",
            "(.*) - Visual Studio Code": "󰨞  VS Code",
            "(.*) - Discord": "󰙯  Discord",
            "^$": "󰇄  Desktop"
        },
        "max-length": 20
    },

    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "interval": 1800,
        "exec": "curl -s 'wttr.in/?format=1'",
        "on-click": "xdg-open https://wttr.in"
    },

    "mpris": {
        "format": "{player_icon} {title}",
        "player-icons": {
            "default": "▶",
            "spotify": "",
            "firefox": ""
        },
        "max-length": 15
    },

    "clock": {
        "format": "  {:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/date": {
        "exec": "date +'%A %d'$(date +%d | sed 's/01/st/;s/02/nd/;s/03/rd/;s/[0-9][1-3]/th/;s/[04-09]/th/;s/1[1-3]/th/')' %B'",
        "interval": 3600,
        "format": "  {}",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": " ",
        "on-click": "pavucontrol"
    },

    "custom/keyboard-light": {
        "format": "󰌌 ",
        "on-click": "brightnessctl -d *kbd_backlight* get | grep -q '^0$' && brightnessctl -d *kbd_backlight* set 100% || brightnessctl -d *kbd_backlight* set 0",
        "on-scroll-up": "brightnessctl -d *kbd_backlight* set 10%+",
        "on-scroll-down": "brightnessctl -d *kbd_backlight* set 10%-",
        "tooltip": false
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": " ",
            "deactivated": " "
        }
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<sup></sup>",
            "none": " ",
            "dnd-notification": "<sup></sup>",
            "dnd-none": " "
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "escape": true
    },

    "custom/power": {
        "format": " ",
        "on-click": "wlogout",
        "tooltip": false
    }
}