{
    "layer": "top",
    "position": "bottom",
    "height": 40,
    "name": "dock",
    "start_hidden": true,
    "on-sigusr1": "toggle",
    "modules-center": [
        "custom/librewolf",
        "custom/vscode",
        "custom/opencode",
        "custom/kitty",
        "custom/dolphin",
        "custom/rofi"
    ],

    "custom/librewolf": {
        "format": "󰈹 ",
        "on-click": "librewolf",
        "tooltip": false
    },

    "custom/vscode": {
        "format": "󰨞 ",
        "on-click": "code",
        "tooltip": false
    },

    "custom/opencode": {
        "format": "󰈔 ",
        "on-click": "opencode",
        "tooltip": false
    },

    "custom/kitty": {
        "format": "󰄠 ",
        "on-click": "kitty",
        "tooltip": false
    },

    "custom/dolphin": {
        "format": "󰉋 ",
        "on-click": "dolphin",
        "tooltip": false
    },

    "custom/rofi": {
        "format": "󰣇 ",
        "on-click": "rofi -show drun",
        "tooltip": false
    }
}