{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "color": {
      "1": "#7aa2f7",
      "2": "#bb9af7",
      "3": "#24283b"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk"
  ],
  "flags": {
    "colorTitle": "#7aa2f7",
    "colorKeys": "#7aa2f7",
    "colorSeparator": "#c0caf5",
    "colorOutput": "#c0caf5",
    "keyWidth": 12
  }
}